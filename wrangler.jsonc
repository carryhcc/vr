{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devr",
  "workers_dev": true,
  "compatibility_date": "2026-07-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "env": {
    "production": {
      "name": "vr"
    }
  }
}
